{
  "manifest_version": 2,
  "name": "Tab & History Manager",
  "version": "0.5",
  "author": "Vitaliy Ponomarev",
  "homepage_url": "https://github.com/vponomarev/firefox-tab-manager",
  "description": "Manage tabs, browse history, and keep a searchable log of visited pages",
  "permissions": ["tabs", "history", "storage"],
  "incognito": "not_allowed",
  "background": {
    "scripts": ["storage.js", "tracker.js", "background.js"],
    "persistent": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "@firefox-tab-manager",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Tabs & History Manager"
  },
  "icons": {
    "48": "icon.svg"
  }
}
